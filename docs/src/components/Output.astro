---
// What a command printed, under the code block that gives the command: a
// terminal window of its own, the output in the colours the command gave it.
// The output is a transcript kept beside the pages (src/transcripts),
// recorded from a real run and cut to what the page is about: a line of "..."
// stands for the lines left out.
import { pick } from '../i18n';

interface Props {
	/** What it printed, ANSI colours and all. */
	out: string;
	/** The title bar. */
	title?: string;
}

const { out, title = pick(Astro.locals.starlightRoute.lang, '실행 결과', 'Output') } = Astro.props;

const escape = (text: string) =>
	text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// The SGR codes the commands use: colours, bold and dim. Anything else is dropped.
const COLOURS: Record<number, string> = {
	30: 'k', 31: 'r', 32: 'g', 33: 'y', 34: 'b', 35: 'm', 36: 'c', 37: 'w',
	90: 'k', 91: 'r', 92: 'g', 93: 'y', 94: 'b', 95: 'm', 96: 'c', 97: 'w',
};

function render(text: string): string {
	return text
		.replace(/\r/g, '')
		.trimEnd()
		.split('\n')
		.map((line) => (line.trim() === '...' ? `<span class="skip">${escape(line)}</span>` : colour(line)))
		.join('\n');
}

function colour(text: string): string {
	let html = '';
	let classes: string[] = [];
	const parts = text.split(/\x1b\[([0-9;]*)m/);
	parts.forEach((part, i) => {
		if (i % 2 === 0) {
			if (part) html += classes.length ? `<span class="${classes.join(' ')}">${escape(part)}</span>` : escape(part);
			return;
		}
		for (const code of (part || '0').split(';').map(Number)) {
			if (code === 0) classes = [];
			else if (code === 1) classes.push('bold');
			else if (code === 2) classes.push('dim');
			else if (code === 39) classes = classes.filter((c) => c.length > 1);
			else if (COLOURS[code]) classes = [...classes.filter((c) => c.length > 1), COLOURS[code]];
		}
	});
	return html;
}
---

<figure class="pk-out not-content">
	<div class="bar">
		<span class="dots" aria-hidden="true"></span>
		<span class="title">{title}</span>
	</div>
	<pre><code class="out" set:html={render(out)}></code></pre>
</figure>

<style>
	.pk-out {
		/* Close under the command it is the result of. */
		margin: 0.75rem 0 1.5rem;
		border: 1px solid #30363d;
		border-radius: 0.6rem;
		background: #0d1117;
		box-shadow: 0 16px 24px -12px rgba(44, 26, 37, 0.5);
		overflow: hidden;
	}
	.bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.45rem 0.75rem;
		background: #161b22;
		border-bottom: 1px solid #30363d;
		color: #8b949e;
		font-size: 0.8rem;
	}
	.dots {
		flex: none;
		width: 2.6rem;
		height: 0.7rem;
		background:
			radial-gradient(circle at 0.35rem 50%, #ff5f57 0.3rem, transparent 0.32rem),
			radial-gradient(circle at 1.3rem 50%, #febc2e 0.3rem, transparent 0.32rem),
			radial-gradient(circle at 2.25rem 50%, #28c840 0.3rem, transparent 0.32rem);
	}
	.title {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		font-family: var(--sl-font-mono);
	}
	pre {
		margin: 0;
		padding: 0.9rem 1rem;
		max-height: 36rem;
		overflow: auto;
		scrollbar-width: thin;
		scrollbar-color: #30363d transparent;
		background: transparent;
		border: 0;
		font-family: var(--sl-font-mono);
		font-size: 0.82rem;
		line-height: 1.55;
		color: #c9d1d9;
		/* Long lines wrap as a terminal window wraps them, so only a long
		 * output scrolls, and only down. */
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	pre::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}
	pre::-webkit-scrollbar-track,
	pre::-webkit-scrollbar-corner {
		background: transparent;
	}
	pre::-webkit-scrollbar-thumb {
		background: #30363d;
		border-radius: 4px;
	}
	pre::-webkit-scrollbar-thumb:hover {
		background: #484f58;
	}
	code {
		font: inherit;
		background: none;
		padding: 0;
		border: 0;
	}
	.out {
		color: #9ba5b0;
	}
	.out :global(.bold) {
		font-weight: 700;
	}
	.out :global(.dim),
	.out :global(.skip) {
		color: #6e7681;
	}
	.out :global(.r) { color: #ff7b72; }
	.out :global(.g) { color: #3fb950; }
	.out :global(.y) { color: #d29922; }
	.out :global(.b) { color: #79c0ff; }
	.out :global(.m) { color: #d2a8ff; }
	.out :global(.c) { color: #56d4dd; }
	.out :global(.w) { color: #e6edf3; }
	.out :global(.k) { color: #6e7681; }
</style>
