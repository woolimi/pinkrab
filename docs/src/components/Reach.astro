---
// The arms' reach on the desk, as the studio's reach switch lays it down.
import Stage3D from './Stage3D.astro';
import { pick } from '../i18n';

const lang = Astro.locals.starlightRoute.lang;
---

<figure class="pk-reach not-content">
	<Stage3D label={pick(lang, '페그보드에 건 두 팔과 책상. 책상 위에 왼팔은 파란색, 오른팔은 분홍색으로 tool 이 집을 수 있는 영역을 칠했습니다.', 'The two arms on the pegboard and the desk. The area the tool can reach is painted on the desk, blue for the left arm and pink for the right.')} />
	<ul class="legend">
		<li><span class="key left" aria-hidden="true"></span>{pick(lang, '왼팔', 'Left arm')} <b data-area="left"></b></li>
		<li><span class="key right" aria-hidden="true"></span>{pick(lang, '오른팔', 'Right arm')} <b data-area="right"></b></li>
	</ul>
</figure>

<script>
	import { SOURCES, whenNear } from '../scripts/arm-figure';

	const figure = document.querySelector<HTMLElement>('.pk-reach');
	if (figure) whenNear(figure, () => import('../scripts/reach.js').then(({ showReach }) => showReach(figure, SOURCES)));
</script>

<style>
	.pk-reach {
		margin: 1.5rem 0;
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.5rem;
		margin: 0.6rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.85rem;
		color: var(--pk-dim);
	}
	.legend li {
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}
	.legend b {
		font-family: var(--sl-font-mono);
		color: var(--pk-text);
	}
	/* The studio's colours, at the patches' own opacity over the desk. */
	.key {
		flex: none;
		width: 0.9rem;
		height: 0.9rem;
		border-radius: 0.2rem;
	}
	.key.left {
		background: color-mix(in srgb, #1668c9 45%, #efe9dd);
	}
	.key.right {
		background: color-mix(in srgb, #e2488e 45%, #efe9dd);
	}

	/* The areas are read with the picture; where it never comes, the figure goes. */
	.pk-reach:not(.ready) .legend {
		visibility: hidden;
	}
	.pk-reach.no-robot {
		display: none;
	}
</style>
