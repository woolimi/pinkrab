---
// A file to download: a button with its name, and the download icon.
interface Props {
	/** The file, by name in public/print. */
	file: string;
}
const { file } = Astro.props;
const href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/print/${file}`;
---

<a class="download" href={href} download>
	<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19h14"></path></svg>
	<span>{file} 내려받기</span>
</a>

<style>
	.download {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 36px;
		padding: 0.3rem 0.9rem;
		border-radius: 0.5rem;
		background: var(--pk-shell);
		color: #fff;
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
	}
	.download:hover {
		background: var(--pk-shell-deep);
	}
	.download:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>
