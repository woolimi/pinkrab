---
// A figure's 3D picture: a canvas a script draws into, with a word
// on how to turn it where it can be turned, and - for a picture worth
// looking into - buttons to come closer and go back.
interface Props {
	label: string;
	zoom?: boolean;
}
const { label, zoom = false } = Astro.props;
---

<div class="stage">
	<canvas role="img" aria-label={label}></canvas>
	{zoom ? (
		<div class="zoom" role="group" aria-label="확대·축소">
			<button type="button" class="in" aria-label="확대">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
			</button>
			<button type="button" class="out" aria-label="축소">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path></svg>
			</button>
		</div>
	) : null}
	<p class="hint">{zoom ? '드래그해서 돌려 보기 · Ctrl + 스크롤로 확대' : '드래그해서 돌려 보기'}</p>
</div>

<style>
	.stage {
		position: relative;
		aspect-ratio: 16 / 10;
		border: 1px solid var(--pk-line);
		border-radius: 0.75rem;
		background: var(--pk-panel);
		overflow: hidden;
	}
	canvas {
		display: block;
		width: 100%;
		height: 100%;
		cursor: grab;
	}
	canvas:active {
		cursor: grabbing;
	}
	.zoom {
		position: absolute;
		top: 0.6rem;
		right: 0.6rem;
		display: flex;
		flex-direction: column;
		border: 1px solid var(--pk-line);
		border-radius: 0.6rem;
		background: #fff;
		overflow: hidden;
	}
	.zoom button {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 0;
		background: transparent;
		color: var(--pk-text);
		cursor: pointer;
		transition: background-color 0.15s ease;
	}
	.zoom button + button {
		border-top: 1px solid var(--pk-line);
	}
	.zoom button:hover:not(:disabled) {
		background: var(--sl-color-accent-low);
	}
	.zoom button:disabled {
		color: var(--pk-dim);
		opacity: 0.5;
		cursor: default;
	}
	.zoom button:focus-visible {
		outline: 2px solid var(--pk-shell);
		outline-offset: -2px;
	}
	.zoom svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
	}
	.hint {
		position: absolute;
		right: 0.5rem;
		bottom: 0.4rem;
		margin: 0;
		padding: 0.1rem 0.45rem;
		border-radius: 0.4rem;
		background: rgb(255 255 255 / 0.85);
		font-size: 0.8rem;
		color: var(--pk-dim);
		pointer-events: none;
	}
	/* Nothing to drag on a phone: there a drag scrolls the page. */
	@media (pointer: coarse) {
		.hint {
			display: none;
		}
		canvas {
			cursor: auto;
		}
	}
	@media (max-width: 560px) {
		.stage {
			aspect-ratio: 1 / 1;
		}
	}
</style>
