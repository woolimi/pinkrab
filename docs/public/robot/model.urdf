      <mass value="0.079"/>
      <inertia ixx="4e-05" ixy="0" ixz="0" iyy="2e-05" iyz="0" izz="4e-05"/>
    </inertial>
    <visual>
      <origin rpy="0 -1.57079633 3.14159265" xyz="-0.014555 0.000707 0.0167"/>
      <geometry>
        <mesh filename="meshes/wrist_yaw_bracket_left.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
