      <geometry>
        <mesh filename="meshes/wrist_yaw_bracket_left.stl"/>
      </geometry>
    </collision>
  </link>
  <!-- The servo wrist yaw carries. Its own link because it is its
         own part - bought rather than printed - and because a viewer that colours
         a link at a time can then tell the two apart. The mass stays with the
         parent: the inertial there describes both, and splitting it wants the
         servo on a scale rather than a number invented here. -->
  <link name="left_wrist_yaw_servo_link">
    <visual>
      <origin rpy="-1.57079633 -0 -3.14159265" xyz="-0.064455 0.000497 0.01739"/>
      <geometry>
        <mesh filename="meshes/servo.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
    <collision>
