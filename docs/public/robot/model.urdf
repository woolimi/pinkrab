    </collision>
  </link>
  <joint name="left_lower_arm_servo_joint" type="fixed">
    <parent link="left_lower_arm_link"/>
    <child link="left_lower_arm_servo_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="left_wrist_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.000103312 0.0386143 0.0281156"/>
      <mass value="0.079"/>
      <inertia ixx="3.68263e-05" ixy="-1.7893e-08" ixz="-5.28128e-08" iyy="2.5391e-05" iyz="-3.6412e-06" izz="2.1e-05"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 -1.5708 0" xyz="0 0.028 0.0181"/>
      <geometry>
        <mesh filename="meshes/wrist_left.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin rpy="1.5708 -1.5708 0" xyz="0 0.028 0.0181"/>
      <geometry>
        <mesh filename="meshes/wrist_left.stl"/>
      </geometry>
    </collision>
  </link>
  <!-- The servo wrist carries. Its own link because it is its
         own part - bought rather than printed - and because a viewer that colours
         a link at a time can then tell the two apart. The mass stays with the
         parent: the inertial there describes both, and splitting it wants the
         servo on a scale rather than a number invented here. -->
  <link name="left_wrist_servo_link">
    <collision>
      <origin rpy="-1.5708 1.5708 0" xyz="8.32667e-17 0.0424 0.0306"/>
      <geometry>
        <mesh filename="meshes/servo_no_horn.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="-1.5708 1.5708 0" xyz="8.32667e-17 0.0424 0.0306"/>
      <geometry>
        <mesh filename="meshes/servo_no_horn.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
  </link>
  <joint name="left_wrist_servo_joint" type="fixed">
    <parent link="left_wrist_link"/>
    <child link="left_wrist_servo_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="left_gripper_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.000213627 -0.000245138 -0.025187"/>
      <mass value="0.087"/>
      <inertia ixx="2.75087e-05" ixy="3.35241e-07" ixz="-5.7352e-06" iyy="4.33657e-05" iyz="5.17847e-08" izz="3.45059e-05"/>
    </inertial>
    <visual>
      <origin rpy="3.14159 -5.55112e-17 0" xyz="8.32667e-17 0.000218214 0.000949706"/>
      <geometry>
        <mesh filename="meshes/claw_left.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin rpy="3.14159 -5.55112e-17 0" xyz="8.32667e-17 0.000218214 0.000949706"/>
      <geometry>
        <mesh filename="meshes/claw_left.stl"/>
      </geometry>
    </collision>
  </link>
  <!-- The servo gripper carries. Its own link because it is its
         own part - bought rather than printed - and because a viewer that colours
         a link at a time can then tell the two apart. The mass stays with the
         parent: the inertial there describes both, and splitting it wants the
         servo on a scale rather than a number invented here. -->
  <link name="left_gripper_servo_link">
    <collision>
      <origin rpy="1.5708 -5.19179e-17 1.66533e-16" xyz="0.0077 -0.0001 -0.0234"/>
      <geometry>
        <mesh filename="meshes/servo.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="1.5708 -5.19179e-17 1.66533e-16" xyz="0.0077 -0.0001 -0.0234"/>
      <geometry>
        <mesh filename="meshes/servo.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
  </link>
  <joint name="left_gripper_servo_joint" type="fixed">
    <parent link="left_gripper_link"/>
    <child link="left_gripper_servo_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- The UMI camera's bracket and the case the camera clicks into, bolted to
         the claw's camera-side wall.
         pinkrab_umi builds this part and the handheld carries the same one: what
         the hand sees while a demonstration is collected and what the arm sees
         while the policy runs are one viewpoint, which is the whole reason the
         mount is shared rather than designed twice. config/camera.yaml is where
         that pose is stated, and build_camera_bracket.py is what carries the
         board to it.

         The mesh is cut in the claw's own frame, so it is placed by the SAME
         origin the claw is - measured back: it lands against the wall at y 24 mm
         with the claw ending there. It is drawn and collided: the arm can meet
         the desk with it, and a camera that is invisible to the scene is one the
         gate would let an operator drive into the board. -->
  <link name="left_camera_bracket_link">
    <visual>
      <origin rpy="3.14159 -5.55112e-17 0" xyz="8.32667e-17 0.000218214 0.000949706"/>
      <geometry>
        <mesh filename="meshes/camera_bracket_left.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin rpy="3.14159 -5.55112e-17 0" xyz="8.32667e-17 0.000218214 0.000949706"/>
      <geometry>
        <mesh filename="meshes/camera_bracket_left.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_camera_bracket_joint" type="fixed">
    <parent link="left_gripper_link"/>
    <child link="left_camera_bracket_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="left_gripper_frame_link">
    <origin rpy="0 -0 0" xyz="0 0 0"/>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <link name="left_jaw_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.00157495 0.0300244 0.0192755"/>
      <mass value="0.012"/>
      <inertia ixx="6.61427e-06" ixy="3.19807e-07" ixz="-5.90717e-09" iyy="1.89032e-06" iyz="1.09945e-07" izz="5.28738e-06"/>
