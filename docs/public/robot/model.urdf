      </geometry>
    </collision>
    <visual>
      <origin rpy="3.14159 -5.27356e-16 1.5708" xyz="-0.11257 0.0155 0.0187"/>
      <geometry>
        <mesh filename="meshes/servo.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
  </link>
  <joint name="left_upper_arm_servo_joint" type="fixed">
    <parent link="left_upper_arm_link"/>
    <child link="left_upper_arm_servo_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="left_lower_arm_link">
    <visual>
      <origin rpy="0 -1.57079633 3.14159265" xyz="-0.014555 0.000707 0.0167"/>
      <geometry>
        <mesh filename="meshes/wrist_yaw_bracket_left.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin rpy="0 -1.57079633 3.14159265" xyz="-0.014555 0.000707 0.0167"/>
      <geometry>
        <mesh filename="meshes/wrist_yaw_bracket_left.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.012 0.035 0.0167"/>
      <mass value="0.079"/>
      <inertia ixx="4e-05" ixy="0" ixz="0" iyy="2e-05" iyz="0" izz="4e-05"/>
    </inertial>
  </link>
  <!-- The servo lower arm carries. Its own link because it is its
         own part - bought rather than printed - and because a viewer that colours
         a link at a time can then tell the two apart. The mass stays with the
         parent: the inertial there describes both, and splitting it wants the
         servo on a scale rather than a number invented here. -->
