      <geometry>
        <mesh filename="meshes/servo.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="-1.5708 1.5708 0" xyz="-0.0303992 -0.000422241 -0.0417"/>
      <geometry>
        <mesh filename="meshes/servo.stl"/>
      </geometry>
      <material name="sts3215"/>
