      </geometry>
    </collision>
  </link>
  <joint name="left_wrist_yaw_servo_joint" type="fixed">
    <parent link="left_wrist_yaw_link"/>
    <child link="left_wrist_yaw_servo_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <joint name="left_gripper_frame_joint" type="fixed">
    <origin rpy="0 3.14159 0" xyz="-0.0079 0.000218121 -0.1081274"/>
    <parent link="left_gripper_link"/>
    <child link="left_gripper_frame_link"/>
    <axis xyz="0 0 0"/>
  </joint>
  <joint name="left_gripper" type="revolute">
    <origin rpy="-1.5708 -5.24284e-08 1.41553e-15" xyz="0.0202 -0.0188 -0.0234"/>
    <parent link="left_gripper_link"/>
    <child link="left_jaw_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" lower="-1.3962634" upper="0.174532925" velocity="10"/>
  </joint>
  <joint name="left_wrist_roll" type="revolute">
    <origin rpy="-1.570866671 -1.518626168 -3.14151957" xyz="5.55112e-17 0.0611 0.0181"/>
    <parent link="left_wrist_link"/>
    <child link="left_gripper_link"/>
