  </link>
  <joint name="left_shoulder_servo_joint" type="fixed">
    <parent link="left_shoulder_link"/>
    <child link="left_shoulder_servo_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="left_upper_arm_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0898471 0.00838224 0.0184089"/>
      <mass value="0.103"/>
      <inertia ixx="4.08002e-05" ixy="1.97819e-05" ixz="-4.03016e-08" iyy="0.000147318" iyz="-8.97326e-09" izz="0.000142487"/>
    </inertial>
    <visual>
      <origin rpy="-3.14159 -0 1.30911e-30" xyz="-0.065085 -0.012 0.0182"/>
      <geometry>
